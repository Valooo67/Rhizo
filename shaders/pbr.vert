#version 450
layout(location=0) in vec3 inPosition;layout(location=1) in vec3 inNormal;layout(location=2) in vec4 inColor;layout(location=3) in vec4 inMaterial;layout(location=4) in vec2 inUv;layout(location=5) in vec4 inTangent;layout(location=6) in vec3 inEmissive;layout(location=7) in uvec4 inBoneIndices;layout(location=8) in vec4 inBoneWeights;
layout(set=2,binding=0,std430) readonly buffer SkinPalette { mat4 boneMatrices[]; } skin;
layout(push_constant) uniform DrawConstants { mat4 viewProjection;mat4 model; } pc;
layout(location=0) out vec3 worldNormal;layout(location=1) out vec3 worldPosition;layout(location=2) out vec4 baseColor;layout(location=3) out vec4 materialData;layout(location=4) out vec2 uv;layout(location=5) out vec4 worldTangent;layout(location=6) out vec3 emissiveFactor;
void main(){mat4 skinMatrix=mat4(1.0);float totalWeight=dot(inBoneWeights,vec4(1.0));if(totalWeight>0.0001){skinMatrix=skin.boneMatrices[inBoneIndices.x]*inBoneWeights.x+skin.boneMatrices[inBoneIndices.y]*inBoneWeights.y+skin.boneMatrices[inBoneIndices.z]*inBoneWeights.z+skin.boneMatrices[inBoneIndices.w]*inBoneWeights.w;skinMatrix/=totalWeight;}vec4 skinnedPosition=skinMatrix*vec4(inPosition,1.0);vec3 skinnedNormal=mat3(skinMatrix)*inNormal;vec4 world=pc.model*skinnedPosition;worldPosition=world.xyz;worldNormal=normalize(transpose(inverse(mat3(pc.model)))*skinnedNormal);baseColor=inColor;materialData=inMaterial;uv=inUv;worldTangent=vec4(normalize(mat3(pc.model)*inTangent.xyz),inTangent.w);emissiveFactor=inEmissive;gl_Position=pc.viewProjection*world;}
