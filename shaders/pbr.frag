#version 450
layout(location=0) in vec3 worldNormal;layout(location=1) in vec3 worldPosition;layout(location=2) in vec4 baseColor;layout(location=3) in vec4 materialData;layout(location=4) in vec2 uv;layout(location=5) in vec4 worldTangent;layout(location=6) in vec3 emissiveFactor;layout(location=0) out vec4 outColor;
struct Light { vec4 positionType;vec4 directionRange;vec4 colorIntensity;vec4 coneShadow; };
layout(std140,set=0,binding=0) uniform SceneData { vec4 cameraPosition;vec4 ambientExposure;mat4 shadowViewProjection[10];ivec4 counts;vec4 renderSettings;vec4 shadowSettings;vec4 environmentSettings;Light lights[8]; } scene;
layout(set=0,binding=1) uniform sampler2D shadowDepth[10];layout(set=0,binding=2) uniform samplerCube environmentMap;layout(set=1,binding=0) uniform sampler2D baseColorMap;layout(set=1,binding=1) uniform sampler2D normalMap;layout(set=1,binding=2) uniform sampler2D metallicRoughnessMap;layout(set=1,binding=3) uniform sampler2D emissiveMap;
const float PI=3.14159265359;
vec2 shadowTexelSize(int index){if(index==4||index==5||index==6||index==7||index==8||index==9)return 1.0/vec2(textureSize(shadowDepth[4],0));return 1.0/vec2(textureSize(shadowDepth[0],0));}
float sampleShadowDepth(int index,vec2 coordinates){if(index==0)return texture(shadowDepth[0],coordinates).r;if(index==1)return texture(shadowDepth[1],coordinates).r;if(index==2)return texture(shadowDepth[2],coordinates).r;if(index==3)return texture(shadowDepth[3],coordinates).r;if(index==4)return texture(shadowDepth[4],coordinates).r;if(index==5)return texture(shadowDepth[5],coordinates).r;if(index==6)return texture(shadowDepth[6],coordinates).r;if(index==7)return texture(shadowDepth[7],coordinates).r;if(index==8)return texture(shadowDepth[8],coordinates).r;return texture(shadowDepth[9],coordinates).r;}
vec3 acesToneMap(vec3 x){return clamp((x*(2.51*x+0.03))/(x*(2.43*x+0.59)+0.14),0.0,1.0);}
float Dggx(vec3 N,vec3 H,float r){float a=r*r,a2=a*a,n=max(dot(N,H),0.0),d=n*n*(a2-1.0)+1.0;return a2/max(PI*d*d,0.0001);}
float Gschlick(float n,float r){float k=(r+1.0)*(r+1.0)/8.0;return n/(n*(1.0-k)+k);}
vec3 Fschlick(float h,vec3 f0){return f0+(1.0-f0)*pow(clamp(1.0-h,0.0,1.0),5.0);}
float shadowFactor(int shadowIndex,vec3 N,vec3 L){if(scene.counts.y==0||shadowIndex<0||shadowIndex>=10)return 1.0;vec4 clip=scene.shadowViewProjection[shadowIndex]*vec4(worldPosition+N*scene.shadowSettings.x,1.0);if(clip.w<=0.0)return 1.0;vec3 p=clip.xyz/clip.w;p.xy=p.xy*0.5+0.5;if(any(lessThan(p,vec3(0.0)))||any(greaterThan(p,vec3(1.0))))return 1.0;float bias=max(scene.renderSettings.w*(1.0-dot(N,L)),0.00008);vec2 texel=shadowTexelSize(shadowIndex);float lit=0.0;for(int x=-1;x<=1;x++)for(int y=-1;y<=1;y++){float depth=sampleShadowDepth(shadowIndex,p.xy+vec2(x,y)*texel);lit+=(p.z-bias<=depth)?1.0:0.0;}return lit/9.0;}
void main(){vec3 N=normalize(worldNormal);if(scene.renderSettings.z>0.5){vec3 T=normalize(worldTangent.xyz-N*dot(N,worldTangent.xyz));vec3 B=normalize(cross(N,T))*worldTangent.w;vec3 mapped=texture(normalMap,uv).xyz*2.0-1.0;mapped.xy*=materialData.z;N=normalize(mat3(T,B,N)*mapped);}vec4 texBase=scene.renderSettings.z>0.5?texture(baseColorMap,uv):vec4(1.0);vec4 mrSample=scene.renderSettings.z>0.5?texture(metallicRoughnessMap,uv):vec4(1.0,1.0,0.0,1.0);vec3 emissive=emissiveFactor*(scene.renderSettings.z>0.5?texture(emissiveMap,uv).rgb:vec3(1.0));vec3 V=normalize(scene.cameraPosition.xyz-worldPosition);float metallic=clamp(materialData.x*mrSample.b,0.0,1.0),roughness=clamp(materialData.y*mrSample.g,0.045,1.0);vec4 finalBase=baseColor*texBase;vec3 albedo=max(finalBase.rgb,vec3(0.0)),f0=mix(vec3(0.04),albedo,metallic);float hemi=clamp(N.y*0.5+0.5,0.0,1.0);vec3 skyIrradiance=scene.ambientExposure.rgb*vec3(1.15,1.22,1.35);vec3 groundIrradiance=scene.ambientExposure.rgb*vec3(0.48,0.43,0.38);vec3 ambientIrradiance=mix(groundIrradiance,skyIrradiance,hemi);vec3 color=albedo*ambientIrradiance*(1.0-metallic*0.65)*clamp(materialData.w,0.0,1.0)*max(scene.ambientExposure.a,0.0);if(scene.environmentSettings.y>0.5){vec3 envN=max(texture(environmentMap,N).rgb,vec3(0.0));vec3 R=reflect(-V,N);vec3 axis=abs(R.y)<0.9?vec3(0.0,1.0,0.0):vec3(1.0,0.0,0.0);vec3 T=normalize(cross(R,axis)),B=normalize(cross(R,T));float spread=roughness*0.32;vec3 envSpec=max(texture(environmentMap,R).rgb,vec3(0.0))*0.4;envSpec+=max(texture(environmentMap,normalize(R+T*spread)).rgb,vec3(0.0))*0.15;envSpec+=max(texture(environmentMap,normalize(R-T*spread)).rgb,vec3(0.0))*0.15;envSpec+=max(texture(environmentMap,normalize(R+B*spread)).rgb,vec3(0.0))*0.15;envSpec+=max(texture(environmentMap,normalize(R-B*spread)).rgb,vec3(0.0))*0.15;vec3 Fenv=Fschlick(max(dot(N,V),0.0),f0);color+=albedo*envN*(1.0-metallic)*0.28*scene.environmentSettings.x+envSpec*Fenv*scene.environmentSettings.x;}
for(int i=0;i<scene.counts.x;i++){Light light=scene.lights[i];vec3 L;float attenuation=1.0;int type=int(light.positionType.w+0.5);if(type==0)L=normalize(-light.directionRange.xyz);else{vec3 toLight=light.positionType.xyz-worldPosition;float dist=length(toLight);L=toLight/max(dist,0.0001);float range=max(light.directionRange.w,0.001);float falloff=clamp(1.0-pow(dist/range,4.0),0.0,1.0);attenuation=falloff*falloff/max(dist*dist,0.01);if(type==2){float cone=dot(normalize(worldPosition-light.positionType.xyz),normalize(light.directionRange.xyz));float spot=clamp((cone-light.coneShadow.y)/max(light.coneShadow.x-light.coneShadow.y,0.0001),0.0,1.0);attenuation*=spot*spot;}}
float nl=max(dot(N,L),0.0);if(nl<=0.0||attenuation<=0.0)continue;vec3 H=normalize(V+L),F=Fschlick(max(dot(H,V),0.0),f0);float D=Dggx(N,H,roughness),G=Gschlick(max(dot(N,V),0.0),roughness)*Gschlick(nl,roughness);vec3 spec=(D*G*F)/max(4.0*max(dot(N,V),0.0)*nl,0.001),kd=(1.0-F)*(1.0-metallic);int shadowIndex=int(light.coneShadow.w+0.5)-1;if(light.coneShadow.w< -1.5){vec3 pointToSurface=worldPosition-light.positionType.xyz;vec3 absoluteDirection=abs(pointToSurface);int face;if(absoluteDirection.x>=absoluteDirection.y&&absoluteDirection.x>=absoluteDirection.z)face=pointToSurface.x>=0.0?0:1;else if(absoluteDirection.y>=absoluteDirection.z)face=pointToSurface.y>=0.0?2:3;else face=pointToSurface.z>=0.0?4:5;shadowIndex=4+face;}else if(light.coneShadow.w< -0.5){float cameraDistance=length(scene.cameraPosition.xyz-worldPosition);shadowIndex=cameraDistance<18.0?0:(cameraDistance<55.0?1:2);}float visibility=(shadowIndex>=0&&scene.counts.y!=0)?shadowFactor(shadowIndex,N,L):1.0;vec3 radiance=light.colorIntensity.rgb*light.colorIntensity.a*attenuation*visibility;color+=(kd*albedo/PI+spec)*radiance*nl;}
if(scene.renderSettings.y<0.5)color=albedo*(0.12+0.88*max(dot(N,normalize(vec3(-0.45,0.85,0.35))),0.0));color*=exp2(clamp(scene.renderSettings.x,-10.0,10.0));color+=emissive;if(scene.environmentSettings.y<=0.5)color=clamp(color,vec3(0.0),vec3(1.0));outColor=vec4(color,finalBase.a);}
