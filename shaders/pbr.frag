#version 450
layout(location=0) in vec3 worldNormal;layout(location=1) in vec3 worldPosition;layout(location=2) in vec4 baseColor;layout(location=3) in vec2 materialData;layout(location=4) in vec2 uv;layout(location=5) in vec4 worldTangent;layout(location=0) out vec4 outColor;
struct Light { vec4 positionType;vec4 directionRange;vec4 colorIntensity;vec4 coneShadow; };
layout(std140,set=0,binding=0) uniform SceneData { vec4 cameraPosition;vec4 ambientExposure;mat4 shadowViewProjection;ivec4 counts;vec4 renderSettings;vec4 shadowSettings;Light lights[8]; } scene;
layout(set=0,binding=1) uniform sampler2D shadowDepth;layout(set=1,binding=0) uniform sampler2D baseColorMap;layout(set=1,binding=1) uniform sampler2D normalMap;layout(set=1,binding=2) uniform sampler2D metallicRoughnessMap;layout(set=1,binding=3) uniform sampler2D emissiveMap;
const float PI=3.14159265359;
float Dggx(vec3 N,vec3 H,float r){float a=r*r,a2=a*a,n=max(dot(N,H),0.0),d=n*n*(a2-1.0)+1.0;return a2/max(PI*d*d,0.0001);}
float Gschlick(float n,float r){float k=(r+1.0)*(r+1.0)/8.0;return n/(n*(1.0-k)+k);}
vec3 Fschlick(float h,vec3 f0){return f0+(1.0-f0)*pow(clamp(1.0-h,0.0,1.0),5.0);}
float shadowFactor(vec3 N,vec3 L){if(scene.counts.y==0)return 1.0;vec4 clip=scene.shadowViewProjection*vec4(worldPosition+N*scene.shadowSettings.x,1.0);if(clip.w<=0.0)return 1.0;vec3 p=clip.xyz/clip.w;p.xy=p.xy*0.5+0.5;if(any(lessThan(p,vec3(0.0)))||any(greaterThan(p,vec3(1.0))))return 1.0;float bias=max(scene.renderSettings.w*(1.0-dot(N,L)),0.00008);vec2 texel=1.0/vec2(textureSize(shadowDepth,0));float lit=0.0;for(int x=-1;x<=1;x++)for(int y=-1;y<=1;y++){float depth=texture(shadowDepth,p.xy+vec2(x,y)*texel).r;lit+=(p.z-bias<=depth)?1.0:0.0;}return lit/9.0;}
void main(){vec3 N=normalize(worldNormal);if(scene.renderSettings.z>0.5){vec3 T=normalize(worldTangent.xyz-N*dot(N,worldTangent.xyz));vec3 B=normalize(cross(N,T))*worldTangent.w;vec3 mapped=texture(normalMap,uv).xyz*2.0-1.0;N=normalize(mat3(T,B,N)*mapped);}vec4 texBase=scene.renderSettings.z>0.5?texture(baseColorMap,uv):vec4(1.0);vec4 mrSample=scene.renderSettings.z>0.5?texture(metallicRoughnessMap,uv):vec4(1.0,1.0,0.0,1.0);vec3 emissive=scene.renderSettings.z>0.5?texture(emissiveMap,uv).rgb:vec3(0.0);vec3 V=normalize(scene.cameraPosition.xyz-worldPosition);float metallic=clamp(materialData.x*mrSample.b,0.0,1.0),roughness=clamp(materialData.y*mrSample.g,0.045,1.0);vec4 finalBase=baseColor*texBase;vec3 albedo=max(finalBase.rgb,vec3(0.0)),f0=mix(vec3(0.04),albedo,metallic);float hemi=clamp(N.y*0.5+0.5,0.0,1.0);vec3 skyIrradiance=scene.ambientExposure.rgb*vec3(1.15,1.22,1.35);vec3 groundIrradiance=scene.ambientExposure.rgb*vec3(0.48,0.43,0.38);vec3 ambientIrradiance=mix(groundIrradiance,skyIrradiance,hemi);vec3 color=albedo*ambientIrradiance*(1.0-metallic*0.65)*max(scene.ambientExposure.a,0.0);
for(int i=0;i<scene.counts.x;i++){Light light=scene.lights[i];vec3 L;float attenuation=1.0;int type=int(light.positionType.w+0.5);if(type==0)L=normalize(-light.directionRange.xyz);else{vec3 toLight=light.positionType.xyz-worldPosition;float dist=length(toLight);L=toLight/max(dist,0.0001);float range=max(light.directionRange.w,0.001);float falloff=clamp(1.0-pow(dist/range,4.0),0.0,1.0);attenuation=falloff*falloff/max(dist*dist,0.01);if(type==2){float cone=dot(normalize(worldPosition-light.positionType.xyz),normalize(light.directionRange.xyz));float spot=clamp((cone-light.coneShadow.y)/max(light.coneShadow.x-light.coneShadow.y,0.0001),0.0,1.0);attenuation*=spot*spot;}}
float nl=max(dot(N,L),0.0);if(nl<=0.0||attenuation<=0.0)continue;vec3 H=normalize(V+L),F=Fschlick(max(dot(H,V),0.0),f0);float D=Dggx(N,H,roughness),G=Gschlick(max(dot(N,V),0.0),roughness)*Gschlick(nl,roughness);vec3 spec=(D*G*F)/max(4.0*max(dot(N,V),0.0)*nl,0.001),kd=(1.0-F)*(1.0-metallic);float visibility=(i==scene.counts.z&&scene.counts.y!=0)?shadowFactor(N,L):1.0;vec3 radiance=light.colorIntensity.rgb*light.colorIntensity.a*attenuation*visibility;color+=(kd*albedo/PI+spec)*radiance*nl;}
if(scene.renderSettings.y<0.5)color=albedo*(0.12+0.88*max(dot(N,normalize(vec3(-0.45,0.85,0.35))),0.0));color*=exp2(clamp(scene.renderSettings.x,-10.0,10.0));color+=emissive;color=color/(color+vec3(1.0));outColor=vec4(pow(max(color,vec3(0.0)),vec3(1.0/2.2)),finalBase.a);}
